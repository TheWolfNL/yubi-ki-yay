<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="yubi-ki-yay"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\Yubi Ki-Yay">
    </Installer>
    <PackageInformation
        PackageName="Yubi Ki-Yay"
        PackageDisplayName="Yubi Ki-Yay"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="Tells you when your YubiKey wants a touch">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.github.thewolfnl.yubikiyay"
                Description="Tells you when your YubiKey wants a touch"
                DisplayName="Yubi Ki-Yay"
                ExecutableName="yubi-ki-yay"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Yubi Ki-Yay</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Tells you when your YubiKey wants a touch</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="yubi-ki-yay.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
